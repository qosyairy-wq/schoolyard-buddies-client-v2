{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schoolyard-buddies-client",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health"]
  },
  "observability": { "enabled": true }
}
